<div class="flex justify-center items-center">
    <div class="join">
        <a href="javascript:" onclick="loadRegistro('{{ date_before }}');" class="btn btn-neutral join-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.75 19.5l-7.5-7.5 7.5-7.5m-6 15L5.25 12l7.5-7.5" />
            </svg>
        </a>
        <a href="javascript:" onclick="loadRegistro('{{ today }}');" class="btn btn-neutral w-36 join-item">
            <span id="oggi">Vai a Oggi</span>
            <span id="loading" class="loading loading-spinner hidden"></span>
        </a>
        <a href="javascript:" onclick="loadRegistro('{{ date_after }}');" class="btn btn-neutral join-item">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 4.5l7.5 7.5-7.5 7.5m-6-15l7.5 7.5-7.5 7.5" />
            </svg>
        </a>
    </div>
</div>
