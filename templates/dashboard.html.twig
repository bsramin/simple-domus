{% extends "base.html.twig" %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/mc-datepicker/dist/mc-calendar.min.css" rel="stylesheet" />
    <style>
        .mc-calendar--inline .mc-picker
        {
            border-radius: inherit;
        }

        .mc-picker {
            background-color: #fff;
            border: 1px solid #55575c;
        }

        #datepicker {
            width: 215px;
            text-align: right;
        }

        #datepicker:focus {
            outline:none !important;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/mc-datepicker/dist/mc-calendar.min.js"></script>
    <script>

        function loadRegistro(date) {
            startLoading();
            fetch("/registro/" + date)
                .then(function(response) {
                    return response.text();
                }).then(function(data) {
                    document.getElementById('registro-block').innerHTML = data;
                    loadDataPicker();
                    stopLoading();
            });
        }

        function formatDate(date = new Date()) {
            const year = date.toLocaleString('default', {year: 'numeric'});
            const month = date.toLocaleString('default', {
                month: '2-digit',
            });
            const day = date.toLocaleString('default', {day: '2-digit'});

            return [year, month, day].join('-');
        }

        function loadDataPicker() {
            const datepicker = MCDatepicker.create({
                el: '#datepicker',
                bodyType: 'inline',
                dateFormat: 'dd/mm/yyyy',
                autoClose: true,
                closeOnBlur: true,
                customWeekDays: ['Domenica', 'Lunedì', 'Martedì', 'Mercoledì', 'Giovedì', 'Venerdì', 'Sabato'],
                customMonths: ['Gennaio', 'Febbraio', 'Marzo', 'Aprile', 'Maggio', 'Giugno', 'Luglio', 'Agosto', 'Settembre', 'Ottobre', 'Novembre', 'Dicembre'],
                customClearBTN: 'Cancella',
                customCancelBTN: 'Annulla',
                firstWeekday: 1
            });
            datepicker.onSelect((date) => {
                loadRegistro(formatDate(date));
            });
        }

        function startLoading()
        {
            document.getElementById('oggi').classList.add('hidden');
            document.getElementById('loading').classList.remove("hidden");

            const myTimeout = setTimeout(stopLoading, 5000);
        }

        function stopLoading()
        {
            document.getElementById('oggi').classList.remove("hidden");
            document.getElementById('loading').classList.add('hidden');
        }

        loadDataPicker();
    </script>
{% endblock %}

{% block body %}
    <div id="registro-block">
        {% include "partial/datepicker.html.twig" %}
        {% include "partial/date_natigator.html.twig" %}
        {% include "partial/list.html.twig" %}
    </div>

    <div class="flex justify-center items-center mt-10 mb-10">
        <div class="relative w-11/12">
            <div class="bg-neutral font-bold p-5 text-2xl text-center text-white">DOCUMENTI</div>
            <div class="bg-neutral-100 rounded-box mt-5 pb-10">
                <table class="table table-zebra">
                    <thead>
                    <tr>
                        <th>&nbsp;&nbsp;&nbsp;Documento</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% set continue = false %}
                    {% set showRow = false %}
                    {% for row in docs.table %}
                        {% set showRow = true %}
                        <tr>
                            <td>
                                {% if row["link"]["links"][0] is not empty %}
                                    <a href="{{ path('download', {'f': row["link"]["links"][0] }) }}">
                                        <strong>» {{ row["description"]["text"] }}</strong>
                                        <div class="text-right"><i class="font-bold">dal</i> {{ row["date_from"]["text"] }}<br><i class="font-bold">al</i> {{ row["date_to"]["text"] }}</div>
                                    </a>
                                {% else %}
                                    &nbsp;
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}

                    {% if showRow == false %}
                        <tr>
                            <td>
                                <div class="text-center border-0 pt-3">
                                    <div class="italic join">
                                        <div class="join-item pr-3"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-accent shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></div>
                                        <div class="join-item">Documenti non presenti</div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
{% endblock %}
